{
  "name": "Starlink Enterprise MCP Agent",
  "description": "Agent for managing Starlink Enterprise terminal fleets through the Starlink Enterprise API. Provides terminal management, telemetry monitoring, service line tracking, data usage analytics, and service availability checking.",
  "version": "1.0.0",
  "url": "https://github.com/ry-ops/starlink-enterprise-mcp-server",
  "protocol": "a2a",
  "capabilities": {
    "streaming": true,
    "tasks": [
      "terminal_management",
      "telemetry_monitoring",
      "service_line_management",
      "data_usage_analytics",
      "address_management",
      "availability_checking"
    ],
    "async": true,
    "authentication": {
      "type": "oauth2_client_credentials",
      "required": true,
      "provider": "starlink_enterprise",
      "scopes": ["enterprise.read", "terminals.read", "telemetry.read"]
    }
  },
  "skills": [
    {
      "id": "list_user_terminals",
      "name": "List User Terminals",
      "description": "List all Starlink user terminals with their current status, supporting pagination for large fleets",
      "category": "terminal_management",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "description": "Page number for pagination",
            "default": 1
          },
          "page_size": {
            "type": "number",
            "description": "Number of results per page (max: 100)",
            "default": 50
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    {
      "id": "get_terminal_details",
      "name": "Get Terminal Details",
      "description": "Get detailed information about a specific terminal including hardware info, configuration, and current status",
      "category": "terminal_management",
      "input_schema": {
        "type": "object",
        "properties": {
          "user_terminal_id": {
            "type": "string",
            "description": "User terminal ID (UUID format)",
            "required": true
          }
        },
        "required": ["user_terminal_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "terminal_id": {
            "type": "string"
          },
          "hardware_version": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "get_terminal_telemetry",
      "name": "Get Terminal Telemetry",
      "description": "Get real-time telemetry data including uptime, signal quality, obstructions, and throughput metrics",
      "category": "telemetry_monitoring",
      "input_schema": {
        "type": "object",
        "properties": {
          "user_terminal_id": {
            "type": "string",
            "description": "User terminal ID",
            "required": true
          }
        },
        "required": ["user_terminal_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "uptime": {
            "type": "number"
          },
          "signal_quality": {
            "type": "number"
          },
          "obstructions": {
            "type": "number"
          },
          "throughput": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "get_terminal_history",
      "name": "Get Terminal History",
      "description": "Get historical telemetry data for a terminal over a specified time period for trend analysis",
      "category": "telemetry_monitoring",
      "input_schema": {
        "type": "object",
        "properties": {
          "user_terminal_id": {
            "type": "string",
            "description": "User terminal ID",
            "required": true
          },
          "start_time": {
            "type": "string",
            "description": "Start time in ISO format (e.g., 2024-01-01T00:00:00Z)",
            "required": true
          },
          "end_time": {
            "type": "string",
            "description": "End time in ISO format",
            "required": true
          }
        },
        "required": ["user_terminal_id", "start_time", "end_time"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "data_points": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "list_service_lines",
      "name": "List Service Lines",
      "description": "List all Starlink service lines (subscriptions/accounts) with pagination support",
      "category": "service_line_management",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "description": "Page number",
            "default": 1
          },
          "page_size": {
            "type": "number",
            "description": "Results per page",
            "default": 50
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "get_service_line_details",
      "name": "Get Service Line Details",
      "description": "Get details about a specific service line including subscription status, plan type, and billing information",
      "category": "service_line_management",
      "input_schema": {
        "type": "object",
        "properties": {
          "service_line_id": {
            "type": "string",
            "description": "Service line ID (UUID format)",
            "required": true
          }
        },
        "required": ["service_line_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "service_line_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "get_data_usage",
      "name": "Get Data Usage",
      "description": "Get data usage statistics for a service line over a specified date range for cost tracking and analysis",
      "category": "data_usage_analytics",
      "input_schema": {
        "type": "object",
        "properties": {
          "service_line_id": {
            "type": "string",
            "description": "Service line ID",
            "required": true
          },
          "start_date": {
            "type": "string",
            "description": "Start date in YYYY-MM-DD format",
            "required": true
          },
          "end_date": {
            "type": "string",
            "description": "End date in YYYY-MM-DD format",
            "required": true
          }
        },
        "required": ["service_line_id", "start_date", "end_date"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "total_usage_gb": {
            "type": "number"
          },
          "daily_breakdown": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "list_addresses",
      "name": "List Addresses",
      "description": "List all service addresses associated with the account",
      "category": "address_management",
      "input_schema": {
        "type": "object",
        "properties": {
          "page": {
            "type": "number",
            "description": "Page number",
            "default": 1
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array"
          }
        }
      }
    },
    {
      "id": "get_address_details",
      "name": "Get Address Details",
      "description": "Get details about a specific service address including location information and service status",
      "category": "address_management",
      "input_schema": {
        "type": "object",
        "properties": {
          "address_id": {
            "type": "string",
            "description": "Address ID (UUID format)",
            "required": true
          }
        },
        "required": ["address_id"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "address_id": {
            "type": "string"
          },
          "location": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "check_service_availability",
      "name": "Check Service Availability",
      "description": "Check if Starlink service is available at a specific geographic location using latitude and longitude coordinates",
      "category": "availability_checking",
      "input_schema": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "description": "Latitude coordinate",
            "required": true
          },
          "longitude": {
            "type": "number",
            "description": "Longitude coordinate",
            "required": true
          }
        },
        "required": ["latitude", "longitude"]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "available": {
            "type": "boolean"
          },
          "estimated_wait_time": {
            "type": "string"
          }
        }
      }
    },
    {
      "id": "get_account_overview",
      "name": "Get Account Overview",
      "description": "Get a complete overview of the Starlink account including all terminals, service lines, addresses, and summary statistics",
      "category": "terminal_management",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "account_summary": {
            "type": "object"
          },
          "terminals": {
            "type": "object"
          },
          "service_lines": {
            "type": "object"
          },
          "addresses": {
            "type": "object"
          }
        }
      }
    },
    {
      "id": "list_subscription_products",
      "name": "List Subscription Products",
      "description": "List available Starlink subscription products and service plans for planning and comparison",
      "category": "service_line_management",
      "input_schema": {
        "type": "object",
        "properties": {}
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array"
          }
        }
      }
    }
  ],
  "authentication_requirements": {
    "environment_variables": [
      {
        "name": "STARLINK_CLIENT_ID",
        "description": "Starlink Enterprise API client ID obtained from service account",
        "required": true,
        "sensitive": true
      },
      {
        "name": "STARLINK_CLIENT_SECRET",
        "description": "Starlink Enterprise API client secret obtained from service account",
        "required": true,
        "sensitive": true
      }
    ],
    "setup_instructions": "Contact your Starlink account manager or email business-support@starlink.com to request API access. Create a service account at https://www.starlink.com/account under Settings > Service Accounts."
  },
  "rate_limits": {
    "authentication": "10 requests/minute",
    "terminal_queries": "100 requests/minute",
    "telemetry": "1000 requests/minute",
    "data_usage": "100 requests/minute"
  },
  "use_cases": [
    "Enterprise fleet management",
    "Real-time terminal monitoring",
    "Data usage tracking and cost analysis",
    "Service expansion planning",
    "Performance troubleshooting",
    "Automated health checks"
  ],
  "integration": {
    "mcp_server": true,
    "protocol_version": "1.0",
    "transport": "stdio",
    "python_version": ">=3.10"
  }
}
